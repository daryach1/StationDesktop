<Page x:Class="StationDesktop.Pages.OneNewRailwayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:StationDesktop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="100" d:DesignWidth="800"
      Title="OneNewRailway"
      Background="Transparent">
    <Grid>
        <TextBlock Text="1 путь"
                   FontSize="20"
                   VerticalAlignment="Center"
                   Margin="10"/>
        <ListBox x:Name="OneNewListBox"
                 Background="Transparent"
                 SelectionMode="Extended"
                 Margin="80,0,0,0">
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Добавить"
                              x:Name="AddMenuItem"
                              Click="AddMenuItem_Click"/>
                    <MenuItem Header="Переместить"
                              x:Name="RelocateMenuItem"
                              Click="RelocateMenuItem_Click"/>
                    <Separator/>
                    <MenuItem Header="Удалить"
                              x:Name="DeleteMenuItem"
                              Click="DeleteMenuItem_Click"/>
                    <Separator/>
                    <MenuItem Header="Редактировать сведения о вагоне"
                              x:Name="EditMenuItem"
                              Click="EditMenuItem_Click"/>
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
