<Window x:Class="StationDesktop.Windows.Station"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StationDesktop.Windows"
        mc:Ignorable="d"
        Title="Станция" Height="500" Width="1000"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        MinHeight="500"
        MinWidth="1000"
        FontFamily="Times New Roman">
    <Grid x:Name="MainGrid"
          Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="30"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="30"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"
                    Grid.Row="0">
            <Image Source="/Resources/suek.png"
                   Margin="5"/>
            <TextBlock Text="StationDesktop"
                       VerticalAlignment="Center"
                       FontSize="34"/>
            <Button x:Name="CreateReportButton"
                    Height="35"
                    Width="120"
                    Content="Сформировать отчет"
                    Background="White"
                    Margin="20,0,0,0"
                    Click="CreateReportButton_Click"/>
        </StackPanel>
        <StackPanel Orientation="Vertical"
                    Margin="30,0,0,0"
                    HorizontalAlignment="Right">
            <TextBlock x:Name="FullNameTextBlock"
                       FontSize="25"
                       Margin="0,10,10,0"/>
            <TextBlock x:Name="PositionTextBlock"
                       FontSize="20"
                       Margin="0,0,10,0"
                       HorizontalAlignment="Right"/>
            <!--<TextBlock x:Name="DateTimeTextBlock"
                            FontSize="18"
                           Margin="0,10,0,0"/>-->
        </StackPanel>
        <StackPanel Orientation="Horizontal"
                    Grid.Row="1">
            <TextBlock Text="Парк Угольный"
                       FontSize="18"
                       Margin="10,5,0,0"/>
        </StackPanel>
        <!--#region Frame-->
        <Frame x:Name="SevenCoal"
               Grid.Row="2"/>
        <Frame x:Name="FiveCoal"
               Grid.Row="3"/>
        <Frame x:Name="ThreeCoal"
               Grid.Row="4"/>
        <Frame x:Name="OneCoal"
               Grid.Row="5"/>
        <Frame x:Name="TwoCoal"
               Grid.Row="6"/>
        <Frame x:Name="FourCoal"
               Grid.Row="7"/>
        <Frame Source="/Pages/OneNewRailwayPage.xaml"
               Grid.Row="9"/>
        <Frame Source="/Pages/ThreeNewRailwayPage.xaml"
               Grid.Row="10"/>
        <Frame Source="/Pages/FiveNewRailwayPage.xaml"
               Grid.Row="11"/>
        <Frame Source="/Pages/SevenNewRailwayPage.xaml"
               Grid.Row="12"/>
        <!--#endregion-->
        <StackPanel Orientation="Horizontal"
                    Grid.Row="8">
            <TextBlock Text="Станция Новая"
                       FontSize="18"
                       Margin="10,5,0,0"/>
        </StackPanel>
    </Grid>
</Window>
