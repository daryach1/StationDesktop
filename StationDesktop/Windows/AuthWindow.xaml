<Window x:Class="StationDesktop.Windows.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StationDesktop"
        mc:Ignorable="d"
        Title="Авторизация" Height="300" Width="500"
        MaxHeight="400"
        MaxWidth="800"
        WindowStartupLocation="CenterScreen"
        FontFamily="Times New Roman"
        ResizeMode="CanMinimize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"
                    Grid.Row="0"
                    HorizontalAlignment="Center">
            <Image Source="/Resources/suek.png"
                   Margin="5"/>
            <TextBlock Text="StationDesktop" VerticalAlignment="Center" FontSize="30"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Логин:"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="0,20,40,0"
                       FontSize="20"
                       Grid.Row="0"
                       Grid.Column="0"/>
            <TextBox x:Name="LoginTextBox"
                     Height="30"
                     Width="300"
                     Grid.Row="0"
                     Grid.Column="1"
                     Margin="0,20,30,0"
                     VerticalContentAlignment="Center"
                     FontSize="20" 
                     PreviewTextInput="LoginTextBox_PreviewTextInput"
                     MaxLength="30"
                     ToolTip="Ввод логина для входа в систему"/>
            <TextBlock Text="Пароль:"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="0,0,40,0"
                       FontSize="20"
                       Grid.Row="1"
                       Grid.Column="0"/>
            <PasswordBox x:Name="PasswordTextBox"
                         Height="30"
                         Width="300"
                         Grid.Row="1"
                         Grid.Column="1"
                         Margin="0,0,30,0"
                         VerticalContentAlignment="Center"
                         FontSize="20"
                         MaxLength="20" 
                         PreviewTextInput="PasswordTextBox_PreviewTextInput"
                         ToolTip="Ввод пароля для входа в систему"/>
        </Grid>
        <StackPanel Orientation="Horizontal"
                    Grid.Row="2"
                    HorizontalAlignment="Center">
            <Button x:Name="LoginButton"
                    Height="40"
                    Width="120"
                    Background="White"
                    Content="Войти"
                    FontSize="20"
                    Click="LoginButton_Click"
                    IsDefault="True"/>
            <Button x:Name="CloseButton"
                    Height="40"
                    Width="120"
                    Background="White"
                    Content="Закрыть"
                    FontSize="20"
                    Margin="20,0,0,0"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
