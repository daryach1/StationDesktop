<Window x:Class="StationDesktop.Windows.AddWagonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StationDesktop.Windows"
        mc:Ignorable="d"
        Title="Добавление вагона" Height="300" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Times New Roman">
    <Grid>
        <StackPanel Orientation="Vertical"
                    VerticalAlignment="Center">
            <TextBlock Text="Введите номер вагона:"
                   FontSize="30"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
            <TextBox x:Name="NumberWagonTextBox"
                     Text="{Binding ShortNumber}"
                     Height="50"
                     Width="200"
                     Margin="0,20,0,0" 
                     PreviewTextInput="NumberWagonTextBox_PreviewTextInput"
                     MaxLength="4"
                     FontSize="30"
                     VerticalContentAlignment="Center"/>
            <Button x:Name="AddWagonButton"
                    Height="50"
                    Width="250"
                    Margin="0,30,0,0"
                    Content="Добавить"
                    FontSize="20"
                    Background="White"
                    Click="AddWagonButton_Click"/>
        </StackPanel>
        
    </Grid>
</Window>
