<Window x:Class="StationDesktop.Windows.AddMarkupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StationDesktop.Windows"
        mc:Ignorable="d"
        Title="Добавление разметки" Height="300" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Times New Roman">
    <Grid>
        <StackPanel Orientation="Vertical"
                    VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Выберите разметку:"
                   FontSize="20"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                           Margin="10,0,0,0"/>
                <ComboBox x:Name="MarkupComboBox"
                      DisplayMemberPath="Title"
                     Height="30"
                     Width="350"
                     Margin="10,0,0,0" 
                     FontSize="20"
                     VerticalContentAlignment="Center"
                      IsEditable="True"/>
            </StackPanel>
            <CheckBox x:Name="IsLoadingCheckBox"
                      Content="Погружен"
                      FontSize="20"
                      Margin="0,30,0,0"
                      HorizontalAlignment="Center"/>
            <Button x:Name="EditButton"
                    Height="40"
                    Width="250"
                    Margin="0,30,0,0"
                    Content="Сохранить"
                    FontSize="20"
                    Background="White"
                    Click="EditButton_Click"/>
        </StackPanel>

    </Grid>
</Window>
